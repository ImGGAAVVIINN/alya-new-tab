{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "0.1.9.11",
  "name": "Alya Start Page",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "offline_enabled": false,
  "chrome_url_overrides": {
    "newtab": "/start/index.html"
  },
  "background": {
    "service_worker": "/start/chrome/background-mv3.js"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "run_at": "document_end",
      "js": [
        "/start/search/content-homepage.js"
      ],
      "matches": [
        "https://*.google.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "128": "start/skin/icons/128.png",
      "16": "start/skin/icons/16.png",
      "48": "start/skin/icons/48.png"
    },
    "default_title": "Alya Start Page"
  },
  "icons": {
    "128": "start/skin/icons/128.png",
    "16": "start/skin/icons/16.png",
    "48": "start/skin/icons/48.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "start/skin/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "permissions": [
    "unlimitedStorage",
    "topSites",
    "management",
    "storage"
  ],
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "{c780473f-234b-4654-8b06-f37e0e2fb600}"
    }
  }
}